# TMDB API key for movie search. Get one at https://www.themoviedb.org/settings/api
# Both the v3 API key and the v4 read access token work.
TMDB_API_KEY=

# Plex movie library sync. Use an IP, not a hostname: the container does not resolve
# LAN hostnames. The token comes from any Plex web request (X-Plex-Token) or from
# Preferences.xml on the Plex server.
PLEX_URL=http://192.168.50.92:32400
PLEX_TOKEN=

# IGDB (game metadata and cover art). Create a Twitch application at
# https://dev.twitch.tv/console/apps to get these.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam library sync. Key from https://steamcommunity.com/dev/apikey
# STEAM_ID accepts a steamid64 or a vanity profile name.
STEAM_API_KEY=
STEAM_ID=

# PlayStation library sync. Log in at https://www.playstation.com then copy
# the token from https://ca.account.sony.com/api/v1/ssocookie
# The token expires roughly every two months. Treat it like a password.
PSN_NPSSO=
